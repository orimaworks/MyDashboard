document.addEventListener("DOMContentLoaded", () => {
    const preloadSound = document.getElementById("steam-sound");
    preloadSound.load();

    const konamiCode = [
        "ArrowUp","ArrowUp",
        "ArrowDown","ArrowDown",
        "ArrowLeft","ArrowRight",
        "ArrowLeft","ArrowRight",
        "b","a"
    ];

    const sims = [
        "r","o","s","e","b","u","d"
        // "m","o","s","e","r","l","o","d","e"
        // "k","l","a","p","a","u","c","i","u","s"
    ];

    const linux = [
        "s","u","d","o"
    ];

    const notfound = [
        "4","0","4"
    ];

    let positionKonami = 0;
    let positionSims = 0;
    let positionLinux = 0;
    let positionnotfound = 0;


    document.addEventListener("keydown", (event) => {

        const target = event.target.tagName.toLowerCase();

        if (target === "input" || target === "textarea") {
            return;
        }

        const key = event.key.toLowerCase();

        // VERSION KONAMI
        if (key === konamiCode[positionKonami].toLowerCase()) {
            positionKonami++;

            if (positionKonami === konamiCode.length) {
                activateEasterEggKonami();
                positionKonami = 0;
            }
        } else {
            positionKonami = key === konamiCode[0].toLowerCase() ? 1 : 0;
        }

        // VERSION SIMS
        if (key === sims[positionSims]) {
            positionSims++;

            if (positionSims === sims.length) {
                activateEasterEggSims();
                positionSims = 0;
            }
        } else {
            positionSims = key === sims[0] ? 1 : 0;
        }

        // VERSION LINUX
        if (key === linux[positionLinux]) {
            positionLinux++;

            if (positionLinux === linux.length) {
                activateEasterEggLinux();
                positionLinux = 0;
            }
        } else {
            positionLinux = key === linux[0] ? 1 : 0;
        }

        // VERSION ERROR 404
        if (key === notfound[positionnotfound]) {
            positionnotfound++;

            if (positionnotfound === notfound.length) {
                activateEasterEggNotfound();
                positionnotfound = 0;
            }
        } else {
            positionnotfound = key === notfound[0] ? 1 : 0;
        }


    });
});

function showEasterToast(type, label, title, description) {
    let toast = document.getElementById("easter-toast");

    if (!toast) {
        toast = document.createElement("div");
        toast.id = "easter-toast";
        document.body.appendChild(toast);
    }

    // Applique le style correspondant au code détecté
    toast.classList.remove("konami", "sims", "linux");
    toast.classList.add(type);

    // Met à jour le contenu
    toast.innerHTML = `
        <div class="achievement-content">
            <div class="achievement-label">${label}</div>
            <div class="achievement-title">${title}</div>
            <div class="achievement-description">${description}</div>
        </div>
    `;

    toast.classList.remove("visible");
    void toast.offsetWidth;
    toast.classList.add("visible");

    clearTimeout(toast._timer);

    toast._timer = setTimeout(() => {
        toast.classList.remove("visible");
    }, 5000);
}



function activateEasterEggKonami() {
    const audio = document.getElementById("steam-sound");

    if (audio) {
        audio.currentTime = 0;
        audio.play().catch(console.warn);
    }

    showEasterToast(
        "konami",
        "New Achievement unlocked",
        "Konami Code, vraiment ?",
        "Désolé, mais KONAMI n'a rien à voir avec tout ça... 😆"
    );
}

function activateEasterEggSims() {
    const audio = document.getElementById("steam-sound");

    if (audio) {
        audio.currentTime = 0;
        audio.play().catch(console.warn);
    }

    showEasterToast(
        "sims",
        "Need More Money",
        "Les temps sont durs ?",
        "1000$ simflouz viennent d'être crédités 🤑"
    );
}

function activateEasterEggLinux() {
    const audio = document.getElementById("steam-sound");

    if (audio) {
        audio.currentTime = 0;
        audio.play().catch(console.warn);
    }

    showEasterToast(
        "linux",
        "Access Granted",
        "Permission accordée",
        "Pendant une durée de 0,0000000004 sec. Faites-vite !"
    );
}


function activateEasterEggNotfound() {
    const audio = document.getElementById("steam-sound");

    if (audio) {
        audio.currentTime = 0;
        audio.play().catch(console.warn);
    }

    showEasterToast(
        "notfound",
        "ERROR 404",
        "Easter Egg not found",
        "Please try again later. Or not."
    );
}