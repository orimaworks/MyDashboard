document.addEventListener("DOMContentLoaded", () => {
    const preloadSound = document.getElementById("steam-sound");
    preloadSound.load();

    const konamiCode = [
        "ArrowUp","ArrowUp",
        "ArrowDown","ArrowDown",
        "ArrowLeft","ArrowRight",
        "ArrowLeft","ArrowRight",
        "b","a"
    ];

    const sims = [
        "r","o","s","e","b","u","d"
        // "m","o","s","e","r","l","o","d","e"
        // "k","l","a","p","a","u","c","i","u","s"
    ];

    const linux = [
        "s","u","d","o"
    ];

    const error404 = [
        "4","0","4"
    ];

    const coffee = [
        "c","a","f","é"
    ];

    const gta = [
        "g","t","a"
    ];

    let positionKonami = 0;
    let positionSims = 0;
    let positionLinux = 0;
    let positionError404 = 0;
    let positionCoffee = 0;
    let positionGta = 0;


    document.addEventListener("keydown", (event) => {

        const target = event.target.tagName.toLowerCase();

        if (target === "input" || target === "textarea") {
            return;
        }

        const key = event.key.toLowerCase();

        // VERSION KONAMI
        if (key === konamiCode[positionKonami].toLowerCase()) {
            positionKonami++;

            if (positionKonami === konamiCode.length) {
                activateEasterEggKonami();
                positionKonami = 0;
            }
        } else {
            positionKonami = key === konamiCode[0].toLowerCase() ? 1 : 0;
        }

        // VERSION SIMS
        if (key === sims[positionSims]) {
            positionSims++;

            if (positionSims === sims.length) {
                activateEasterEggSims();
                positionSims = 0;
            }
        } else {
            positionSims = key === sims[0] ? 1 : 0;
        }

        // VERSION LINUX
        if (key === linux[positionLinux]) {
            positionLinux++;

            if (positionLinux === linux.length) {
                activateEasterEggLinux();
                positionLinux = 0;
            }
        } else {
            positionLinux = key === linux[0] ? 1 : 0;
        }

        // VERSION ERROR 404
        if (key === error404[positionError404]) {
            positionError404++;

            if (positionError404 === error404.length) {
                activateEasterEggError404();
                positionError404 = 0;
            }
        } else {
            positionError404 = key === error404[0] ? 1 : 0;
        }
        
        // VERSION CAFE
        if (key === coffee[positionCoffee]) {
            positionCoffee++;

            if (positionCoffee === coffee.length) {
                activateEasterEggCoffee();
                positionCoffee = 0;
            }
        } else {
            positionCoffee = key === coffee[0] ? 1 : 0;
        }
        
        // VERSION GTA
        if (key === gta[positionGta]) {
            positionGta++;

            if (positionGta === gta.length) {
                activateEasterEggGta();
                positionGta = 0;
            }
        } else {
            positionGta = key === gta[0] ? 1 : 0;
        }



    });
});

function showEasterToast(type, label, title, description) {
    let toast = document.getElementById("easter-toast");

    if (!toast) {
        toast = document.createElement("div");
        toast.id = "easter-toast";
        document.body.appendChild(toast);
    }

    // Applique le style correspondant au code détecté
    toast.classList.remove("konami", "sims", "linux", "rockstar","error404", "coffee" );
    toast.classList.add(type);

    // Met à jour le contenu
    toast.innerHTML = `
        <div class="achievement-content">
            <div class="achievement-label">${label}</div>
            <div class="achievement-title">${title}</div>
            <div class="achievement-description">${description}</div>
        </div>
    `;

    toast.classList.remove("visible");
    void toast.offsetWidth;
    toast.classList.add("visible");

    clearTimeout(toast._timer);

    toast._timer = setTimeout(() => {
        toast.classList.remove("visible");
    }, 7000);
}



function activateEasterEggKonami() {
    const audio = document.getElementById("steam-sound");

    if (audio) {
        audio.currentTime = 0;
        audio.play().catch(console.warn);
    }

    showEasterToast(
        "konami",
        "New Achievement unlocked",
        "Konami Code, vraiment ?",
        "Désolé, mais KONAMI n'a rien à voir avec tout ça... 😆"
    );
}

function activateEasterEggSims() {
    const audio = document.getElementById("steam-sound");

    if (audio) {
        audio.currentTime = 0;
        audio.play().catch(console.warn);
    }

    showEasterToast(
        "sims",
        "Need More Money",
        "Les temps sont durs ?",
        "1000$ simflouz viennent d'être crédités 🤑"
    );
}

function activateEasterEggLinux() {
    const audio = document.getElementById("steam-sound");

    if (audio) {
        audio.currentTime = 0;
        audio.play().catch(console.warn);
    }

    showEasterToast(
        "linux",
        "Access Granted",
        "Permission accordée",
        "Pendant une durée de 0,0000000004 sec. Faites-vite !"
    );
}


function activateEasterEggError404() {
    const audio = document.getElementById("steam-sound");

    if (audio) {
        audio.currentTime = 0;
        audio.play().catch(console.warn);
    }

    showEasterToast(
        "error404",
        "ERROR 404",
        "Easter Egg not found",
        "Please try again later. Or not."
    );
}

function activateEasterEggCoffee() {
    const audio = document.getElementById("steam-sound");

    if (audio) {
        audio.currentTime = 0;
        audio.play().catch(console.warn);
    }

    showEasterToast(
        "coffee",
        "HAVE A BREAK",
        "Un p'tit café ?",
        "La pause s'impose. Prenez donc un café !"
    );
}

function activateEasterEggGta() {
    const audio = document.getElementById("steam-sound");

    if (audio) {
        audio.currentTime = 0;
        audio.play().catch(console.warn);
    }

    showEasterToast(
        "gta",
        "Bienvenue à Los Santos",
        "Trevor vous passe le bonjour",
        "Quoi de mieux qu'une virée à Los Santos ? Pas grand chose hein... on est d'accord ! "
    );
}