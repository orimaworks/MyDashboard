document.addEventListener("DOMContentLoaded", () => {
    const preloadSound = document.getElementById("steam-sound");
    preloadSound.load();

    const konamiCode = [
        "ArrowUp","ArrowUp",
        "ArrowDown","ArrowDown",
        "ArrowLeft","ArrowRight",
        "ArrowLeft","ArrowRight",
        "b","a"
    ];


    const sims = [
        "r","o","s","e","b","u","d"
        // "m","o","s","e","r","l","o","d","e"
        // "k","l","a","p","a","u","c","i","u","s"
    ];

    let position = 0;

    document.addEventListener("keydown", (event) => {

        const target = event.target.tagName.toLowerCase();

        if (target === "input" || target === "textarea") {
            return;
        }

        const key = event.key.toLowerCase();

        //VERSION KONAMI
        if (key === konamiCode[position].toLowerCase()) {
            position++;

            if (position === konamiCode.length) {
                activateEasterEggKonami();
                position = 0;
            }

        } else {
            position = 0;
        }


        //VERSION SIMS
        if (key === sims[position].toLowerCase()) {
            position++;

            if (position === sims.length) {
                activateEasterEggSims();
                position = 0;
            }

        } else {
            position = 0;
        }




    });
});

function activateEasterEggKonami() {
     const audio = document.getElementById("steam-sound");
    if (audio) {
        audio.currentTime = 0;
        audio.play().catch(console.warn);
    }

    let toast = document.getElementById("easter-toast");

    if (!toast) {
        toast = document.createElement("div");
        toast.id = "easter-toast";

        toast.innerHTML = `
    <div class="achievement-content">
        <div class="achievement-label">New Achievement unlocked</div>
        <div class="achievement-title">Konami Code, vraiment ?</div>
        <div class="achievement-description">
            Désolé, mais KONAMI n'a rien à voir avec tout ça...😆
        </div>
    </div>
`;

        document.body.appendChild(toast);
    }

    // Force l'état initial
    toast.classList.remove("visible");

    // Force un reflow
    void toast.offsetWidth;

    // Lance l'animation
    toast.classList.add("visible");

    clearTimeout(toast._timer);

    toast._timer = setTimeout(() => {
        toast.classList.remove("visible");
    }, 5000);
}





function activateEasterEggSims() {
     const audio = document.getElementById("steam-sound");
    if (audio) {
        audio.currentTime = 0;
        audio.play().catch(console.warn);
    }

    let toast = document.getElementById("easter-toast");

    if (!toast) {
        toast = document.createElement("div");
        toast.id = "easter-toast";

        toast.innerHTML = `
    <div class="achievement-content">
        <div class="achievement-label">More Money</div>
        <div class="achievement-title">Besoin d'argent ?</div>
        <div class="achievement-description">
            1000¤ simflooz viennent d'être crédités 😆
        </div>
    </div>
`;

        document.body.appendChild(toast);
    }

    // Force l'état initial
    toast.classList.remove("visible");

    // Force un reflow
    void toast.offsetWidth;

    // Lance l'animation
    toast.classList.add("visible");

    clearTimeout(toast._timer);

    toast._timer = setTimeout(() => {
        toast.classList.remove("visible");
    }, 5000);
}